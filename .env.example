# ReconEveryThings optional configuration.
# Copy this file to .env and fill in only the values you need.
# Existing environment variables always take precedence over .env values.

# API keys and tokens (optional; improve coverage and rate limits).
GITHUB_TOKEN=
GITLAB_TOKEN=
NVD_API_KEY=
VULNERS_API_KEY=
SHODAN_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Breach metadata APIs. Leave empty to skip breach lookup.
HIBP_API_KEY=
LEAKCHECK_API_KEY=

# Network behavior.
REC_PROXY=
REC_TIMEOUT=15
REC_CONNECT_TIMEOUT=8
REC_VERIFY_TLS=false
REC_NORMAL_RATE=8
REC_STEALTH_RATE=2
# OSINT match strictness: 0 current behavior, 1 stronger identity evidence.
REC_STRICT=0
REC_THREADS=8
REC_JITTER_MIN=0.5
REC_JITTER_MAX=2.5

# Collection limits.
REC_MAX_RESPONSE_BYTES=2500000
REC_MAX_DOCUMENT_BYTES=15000000
REC_MAX_SUBDOMAINS=500
REC_MAX_HOSTS=150
REC_MAX_JS_FILES=30
REC_MAX_CRAWL_PAGES=12
REC_MAX_VULN_QUERIES=12
REC_MAX_OSINT_ITEMS=10
REC_MAX_TECH_URLS=60
REC_MAX_FUZZ_REQUESTS=900
REC_MAX_FUZZ_DEPTH=2
REC_MAX_FUZZ_HOSTS=1
REC_MAX_FUZZ_DIRS=12
REC_MAX_ASSET_HOSTS=12
REC_MAX_ASSET_PAGES=25
REC_MAX_ASSET_DEPTH=3
REC_MAX_ASSETS=800
REC_MAX_VHOST_REQUESTS=400
REC_MAX_VHOST_HOSTS=1
REC_MAX_WAYBACK_URLS=200
REC_MAX_USERNAME_SITES=120
# Leave empty to use the upstream WhatsMyName JSON list.
REC_WHATSMYNAME_URL=
REC_WHATSMYNAME_FILE=
REC_MAX_BREACH_EMAILS=3
REC_MAX_BREACH_USERNAMES=2
REC_MAX_BREACH_FINDINGS=200

# Custom wordlists. Leave empty to use the bundled lists.
REC_WORDLIST=
REC_VHOST_WORDLIST=

# External binary names or absolute paths.
# install.sh fills these with absolute paths after building the Go tools.
REC_SUBFINDER_BIN=subfinder
REC_HTTPX_BIN=httpx
REC_NAABU_BIN=naabu
REC_KATANA_BIN=katana
REC_GAU_BIN=gau
REC_WAFW00F_BIN=wafw00f
REC_NMAP_BIN=nmap
REC_WHATWEB_BIN=whatweb
REC_WEBANALYZE_BIN=webanalyze
# webanalyze technology definitions; install.sh fills this in.
REC_WEBANALYZE_APPS=~/.local/share/reconeverythings/technologies.json

# Log color mode: auto, always, or never.
REC_COLOR=auto

# MCP session workspace.
REC_WORKSPACE=./.rec_workspace

# To load a different file, set this in your shell, not inside .env:
# REC_ENV_FILE=/path/to/engagement.env
